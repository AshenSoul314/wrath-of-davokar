        <g class="wave-layer wave-back">
          <use href="#wave-tile-back" x="-1440"/>
          <use href="#wave-tile-back" x="0"/>
          <use href="#wave-tile-back" x="1440"/>
        </g>
        <g class="wave-layer wave-mid">
          <use href="#wave-tile-mid" x="-1440"/>
          <use href="#wave-tile-mid" x="0"/>
          <use href="#wave-tile-mid" x="1440"/>

        </g>
        <g class="wave-layer wave-front">
          <use href="#wave-tile-front" x="-1440"/>
          <use href="#wave-tile-front" x="0"/>
          <use href="#wave-tile-front" x="1440"/>
