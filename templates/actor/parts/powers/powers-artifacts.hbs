<div class="flex-column flex-group-center flex-align-stretch flex-gap">
  {{#each artifacts as |item|}}
    <div class="panel item draggable" data-item-id="{{item._id}}">
      <div class="panel-header flex-row flex-group-center flex-gap">
        <div class='item-image'>
          <img src='{{item.img}}' title='{{item.name}}' width='40' height='40'/>
        </div>
        <span class="flex-grow">{{item.name}}</span>
        <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

        {{#if ../editMode}}
          <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=item.name}}'><i class='fas fa-edit'></i></a>
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=item.name}}'><i class='fas fa-trash'></i></a>
        {{/if}}
      </div>

      <div class="panel-content flex-row flex-wrap flex-gap flex-group-left flex-align-stretch">
        {{#each item.resolvedPowers as |power|}}
          <div class="talent-card item flex-grow draggable" data-item-id="{{power._id}}">
            <div class="talent-header flex-row flex-group-center flex-gap">
              <div class='item-image'>
                <img src='{{power.img}}' title='{{power.name}}' width='40' height='40'/>
              </div>
              <span class="flex-grow">{{power.name}}</span>
              <a class='item-control' data-action="itemRoll" title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

              {{#if ../../editMode}}
                <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.artifactPower")}}'><i class='fas fa-edit'></i></a>
                <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.artifactPower")}}'><i class='fas fa-trash'></i></a>
              {{/if}}
            </div>
            <div class="talent-content">
              <div class="talent-text">
                {{{power.enrichedDescription}}}
              </div>
              <div class="resource-grid">
                <b>{{localize "WRATH_OF_DAVOKAR.Action.Label"}}:</b>
                <span>{{localizeActions power.system.action}}</span>
                <b>{{localize "WRATH_OF_DAVOKAR.Corruption.Label"}}:</b>
                <span class='die-roll rollable' data-roll="{{power.system.corruption}}" data-label="{{localize 'WRATH_OF_DAVOKAR.Corruption.Temporary.long'}}">
                  <i class="fa-solid fa-dice fa-xl-d20"></i> {{power.system.corruption}}
                </span>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
</div>
