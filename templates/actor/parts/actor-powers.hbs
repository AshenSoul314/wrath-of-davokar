<section class="tab {{tab.cssClass}} powers-tab " data-group="primary" data-tab="powers">

  <div class="sticky">
    {{> "templates/generic/tab-navigation.hbs" tabs=powerTabs}}

    {{!-- Search Bar --}}
    <div class='search-bar flex-row'>
      <i class='fa-solid fa-magnifying-glass search-icon'></i>
      <input class="search-input" type='text'>
    </div>
  </div>

  <div class="powers-body">
    <section class="tab {{subTabs.mysticalPowers.cssClass}}" data-group="powers" data-tab="mysticalPowers">
      {{> "systems/wrath-of-davokar/templates/actor/parts/powers/powers-mysticalPowers.hbs"}}
    </section>

    <section class="tab {{subTabs.rituals.cssClass}}" data-group="powers" data-tab="rituals">
      {{> "systems/wrath-of-davokar/templates/actor/parts/powers/powers-rituals.hbs"}}
    </section>

    <section class="tab {{subTabs.artifacts.cssClass}}" data-group="powers" data-tab="artifacts">
      {{> "systems/wrath-of-davokar/templates/actor/parts/powers/powers-artifacts.hbs"}}
    </section>
  </div>
</section>
