<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="description">
  <div class="grid grid-2col">

    {{!-- Bio --}}
    <div class="panel">
      <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Bio.Description'}}</div>
      {{#if editMode}}
        <prose-mirror name="system.bio.description" toggled="true" button="true">{{{enrichedDescription}}}</prose-mirror>
      {{else}}
        {{{enrichedDescription}}}
      {{/if}}
    </div>

    {{!-- Traits & Bio Fields --}}
    <div class="flex-column flex-group-center flex-align-stretch">
      <div class="panel">
        <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Bio.Traits'}}</div>
        <div class="panel-content grid grid-3col">
          <div class="resource-title-small">{{localize 'WRATH_OF_DAVOKAR.Bio.Age'}}</div>
          <div class="resource-title-small">{{localize 'WRATH_OF_DAVOKAR.Bio.Height'}}</div>
          <div class="resource-title-small">{{localize 'WRATH_OF_DAVOKAR.Bio.Weight'}}</div>

          {{#if editMode}}
            <input class="trait-text" type="text" name="system.bio.age"    value="{{system.bio.age}}"/>
            <input class="trait-text" type="text" name="system.bio.height" value="{{system.bio.height}}"/>
            <input class="trait-text" type="text" name="system.bio.weight" value="{{system.bio.weight}}"/>
          {{else}}
            <span class="trait-text">{{system.bio.age}}</span>
            <span class="trait-text">{{system.bio.height}}</span>
            <span class="trait-text">{{system.bio.weight}}</span>
          {{/if}}

          <div class="grid-span-3 resource-title">{{localize 'WRATH_OF_DAVOKAR.Bio.Appearance'}}</div>
          {{#if editMode}}
            <textarea class="grid-span-3 trait-text" name="system.bio.appearance" rows="4">{{system.bio.appearance}}</textarea>
          {{else}}
            <p class="grid-span-3 align-left trait-text">{{system.bio.appearance}}</p>
          {{/if}}

          <div class="grid-span-3 resource-title">{{localize 'WRATH_OF_DAVOKAR.Bio.Quote'}}</div>
          {{#if editMode}}
            <textarea class="grid-span-3 trait-text" name="system.bio.quote" rows="4">{{system.bio.quote}}</textarea>
          {{else}}
            <p class="grid-span-3 align-left trait-text">{{system.bio.quote}}</p>
          {{/if}}

          <div class="grid-span-3 resource-title">{{localize 'WRATH_OF_DAVOKAR.Bio.Shadow'}}</div>
          {{#if editMode}}
            <textarea class="grid-span-3 trait-text" name="system.bio.shadow" rows="4">{{system.bio.shadow}}</textarea>
          {{else}}
            <p class="grid-span-3 align-left trait-text">{{system.bio.shadow}}</p>
          {{/if}}

          <div class="grid-span-3 resource-title">{{localize 'WRATH_OF_DAVOKAR.Bio.Ambition'}}</div>
          {{#if editMode}}
            <textarea class="grid-span-3 trait-text" name="system.bio.ambition" rows="4">{{system.bio.ambition}}</textarea>
          {{else}}
            <p class="grid-span-3 align-left trait-text">{{system.bio.ambition}}</p>
          {{/if}}

          <div class="grid-span-3 resource-title">{{localize 'WRATH_OF_DAVOKAR.Bio.Weakness'}}</div>
          {{#if editMode}}
            <textarea class="grid-span-3 trait-text" name="system.bio.weakness" rows="4">{{system.bio.weakness}}</textarea>
          {{else}}
            <p class="grid-span-3 align-left trait-text">{{system.bio.weakness}}</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</section>
