<div class="talent-grid">
  {{#each burdens}}
    <div class="talent-card item flex-grow draggable" data-item-id="{{this._id}}">
      <div class="talent-header flex-row flex-group-center flex-gap">
        <div class='item-image'>
          <img src='{{this.img}}' title='{{this.name}}' width='40' height='40'/>
        </div>
        <span class="flex-grow">{{this.name}}</span>
        <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

        {{#if ../editMode}}
          <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.burden")}}'><i class='fas fa-edit'></i></a>
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.burden")}}'><i class='fas fa-trash'></i></a>
        {{/if}}
      </div>
      <div class="talent-content">
        <div class="talent-text">
          {{{this.enrichedDescription}}}
        </div>
      </div>
    </div>
  {{/each}}
</div>
