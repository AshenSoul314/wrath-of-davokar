<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="main">

  {{!-- First Row --}}
  <div class="flex-row">

    {{!-- Column One: Core Traits --}}
    <div class="flex-column flex-wrap flex-group-left flex-align-start flex-shrink">

      {{!-- Toughness --}}
      <div class="panel-no-flex">
        <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Toughness.Label'}}</div>
        <div class="panel-content grid grid-6col flex-align-center">
          <div class="progress-bar grid-span-6">
            <div class="bar-toughness" style="width:{{system.toughness.percent}}%;"></div>
          </div>
          <input class="grid-span-2 align-center" type='number' step="1" min="0" max="{{system.toughness.max}}" name="system.toughness.value" value="{{system.toughness.value}}" data-dtype="Number"/>

          <div class="grid-span-2 align-center"> / </div>

          {{#if editMode}}
            <input class="grid-span-2 align-center" type='number' step="1" min="0" name="system.toughness.max" value="{{system.toughness.max}}" data-dtype="Number"/>
          {{else}}
            <div class="grid-span-2 align-center">{{system.toughness.max}}</div>
          {{/if}}

          <div class="grid-span-4">{{localize 'WRATH_OF_DAVOKAR.Toughness.Threshold'}}: </div>
          {{#if editMode}}
            <input class="grid-span-2 align-center" type='number' step="1" min="0" name="system.toughness.threshold" value="{{system.toughness.threshold}}" data-dtype="Number"/>
          {{else}}
            <div class="grid-span-2 align-center">{{system.toughness.threshold}}</div>
          {{/if}}
        </div>
      </div>

      {{!-- Corruption --}}
      <div class="panel-no-flex">
        <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Corruption.Label'}}</div>
        <div class="panel-content grid grid-2col flex-align-center">

          <div class="progress-bar grid-span-2">
            <div class="bar-corruption-threshold" style="left:{{system.corruption.thresholdPercent}}%;" title="{{localize 'WRATH_OF_DAVOKAR.Corruption.Threshold.long'}}"></div>
            <div class="bar-corruption-permanent" style="width:{{system.corruption.permanent.percent}}%;" title="{{localize 'WRATH_OF_DAVOKAR.Corruption.Permanent.long'}}"></div>
            <div class="bar-corruption-temporary" style="width:{{system.corruption.temporary.percent}}%;" title="{{localize 'WRATH_OF_DAVOKAR.Corruption.Temporary.long'}}"></div>
          </div>

          <div>{{localize 'WRATH_OF_DAVOKAR.Corruption.Total.long'}}:</div>
          <div class="align-left">{{system.corruption.value}}</div>

          <div>{{localize 'WRATH_OF_DAVOKAR.Corruption.Permanent.short'}}:</div>
          <div class="flex-row flex-gap flex-align-center">
            <input class="corruption-permanent flex-grow" type='number' step="1" min="0"
              value="{{system.corruption.permanent.value}}"
              name="system.corruption.permanent.value"
              data-dtype="Number"/>
            {{#if (gt system.corruption.permanent.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(+{{system.corruption.permanent.bonus}})</span>{{/if}}
            {{#if (lt system.corruption.permanent.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.corruption.permanent.bonus}})</span>{{/if}}
            {{#if (eq system.corruption.permanent.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(±0)</span>{{/if}}
          </div>

          <div>{{localize 'WRATH_OF_DAVOKAR.Corruption.Temporary.short'}}:</div>
          <div class="flex-row flex-gap flex-align-center">
            <input class="corruption-temporary flex-grow" type='number' step="1" min="0"
              value="{{system.corruption.temporary.value}}"
              name="system.corruption.temporary.value"
              data-dtype="Number"/>
            {{#if (gt system.corruption.temporary.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(+{{system.corruption.temporary.bonus}})</span>{{/if}}
            {{#if (lt system.corruption.temporary.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.corruption.temporary.bonus}})</span>{{/if}}
            {{#if (eq system.corruption.temporary.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(±0)</span>{{/if}}
          </div>

          <div>{{localize 'WRATH_OF_DAVOKAR.Corruption.Threshold.short'}}:</div>
          <div class="flex-row flex-gap flex-align-center">
            {{#if editMode}}
              <input class="flex-grow" type='number' step="1" min="0"
                value="{{system.corruption.threshold.value}}"
                name="system.corruption.threshold.value"
                data-dtype="Number"/>
              {{#if (gt system.corruption.threshold.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(+{{system.corruption.threshold.bonus}})</span>{{/if}}
              {{#if (lt system.corruption.threshold.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.corruption.threshold.bonus}})</span>{{/if}}
              {{#if (eq system.corruption.threshold.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(±0)</span>{{/if}}
            {{else}}
              <span>{{system.corruption.threshold.total}}</span>
            {{/if}}
          </div>
          <div>{{localize 'WRATH_OF_DAVOKAR.Corruption.Max.short'}}:</div>
          <div class="flex-row flex-gap flex-align-center">

            {{#if editMode}}
              <input class="flex-grow" type='number' step="1" min="0"
                value="{{system.corruption.thresholdMax.value}}"
                name="system.corruption.thresholdMax.value"
                data-dtype="Number"/>
              {{#if (gt system.corruption.thresholdMax.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(+{{system.corruption.thresholdMax.bonus}})</span>{{/if}}
              {{#if (lt system.corruption.thresholdMax.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.corruption.thresholdMax.bonus}})</span>{{/if}}
              {{#if (eq system.corruption.thresholdMax.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(±0)</span>{{/if}}
            {{else}}
              <span>{{system.corruption.thresholdMax.total}}</span>
            {{/if}}
          </div>
        </div>
      </div>

      {{!-- Willpower --}}
      <div class="panel-no-flex">
        <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Willpower.Label'}}</div>
        <div class="panel-content grid grid-2col flex-align-center">
          <div class="grid-span-2">
            {{generateWillpowerBar actorId}}
          </div>
