      </div>
    </div>
  </div>

  {{!-- Second Row --}}
  <div class="flex-row">
    <div class="flex-column flex-wrap flex-group-center flex-align-stretch flexgrow">

      {{!-- Equipped Armor --}}
      <div class="panel">
        <div class="panel-header">{{localize 'WRATH_OF_DAVOKAR.Armor.Label'}}</div>
        <ol class='panel-content items-list'>

          {{#if actor.equippedArmorBody}}
            <li class='item flex-column' data-item-id='{{actor.equippedArmorBody.id}}'>
              <div class="flex-row max-width">
                <div class='item-name item-control' data-action="itemEdit">
                  <div class='item-image'><img src='{{actor.equippedArmorBody.img}}' title='{{actor.equippedArmorBody.name}}' width='24' height='24'/></div>
                  <h4>{{actor.equippedArmorBody.name}}
                    {{#if actor.equippedArmorBody.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}
                  </h4>
                </div>
                <div class='item-attribute'>
                  <span>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.abbv'}}:
                    <input class='input-skill' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{actor.equippedArmorBody.id}}' value='{{actor.equippedArmorBody.system.rating.value}}'/>
                    / {{actor.equippedArmorBody.system.rating.max}}
                  </span>
                </div>
                <div class='item-attribute'><span>{{localize 'WRATH_OF_DAVOKAR.Armor.Impeding.abbv'}}: {{actor.equippedArmorBody.system.impeding}}</span></div>
                <div class='item-controls'>
                  <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorBody")}}'>
                    <img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/>
                  </a>
                </div>
              </div>
              <div class="flex-row quality-list-row">
                {{#each actor.equippedArmorBody.system.qualities as |quality|}}<label class='quality flexshrink'>{{#if quality}}{{localizeQuality @key}}{{/if}}</label>{{/each}}
              </div>
            </li>
          {{/if}}

          {{#if actor.equippedArmorHead}}
            <li class='item flex-column' data-item-id='{{actor.equippedArmorHead.id}}'>
              <div class="flex-row max-width">
                <div class='item-name item-control' data-action="itemEdit">
                  <div class='item-image'><img src='{{actor.equippedArmorHead.img}}' title='{{actor.equippedArmorHead.name}}' width='24' height='24'/></div>
                  <h4>{{actor.equippedArmorHead.name}}
                    {{#if actor.equippedArmorHead.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}
                  </h4>
                </div>
                <div class='item-attribute'>
                  <span>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.abbv'}}:
                    <input class='input-skill' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{actor.equippedArmorHead.id}}' value='{{actor.equippedArmorHead.system.rating.value}}'/>
                    / {{actor.equippedArmorHead.system.rating.max}}
                  </span>
                </div>
                <div class='item-attribute'><span>{{localize 'WRATH_OF_DAVOKAR.Armor.VisionPenalty.abbv'}}: {{actor.equippedArmorHead.system.visionPenalty}}</span></div>
                <div class='item-controls'>
                  <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorHead")}}'>
                    <img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/>
                  </a>
                </div>
              </div>
              <div class="flex-row quality-list-row">
                {{#each actor.equippedArmorHead.system.qualities as |quality|}}<label class='quality flexshrink'>{{#if quality}}{{localizeQuality @key}}{{/if}}</label>{{/each}}
              </div>
            </li>
          {{/if}}

          {{#if actor.equippedArmorShield}}
            <li class='item flex-column' data-item-id='{{actor.equippedArmorShield.id}}'>
              <div class="flex-row max-width">
                <div class='item-name item-control' data-action="itemEdit">
                  <div class='item-image'><img src='{{actor.equippedArmorShield.img}}' title='{{actor.equippedArmorShield.name}}' width='24' height='24'/></div>
                  <h4>{{actor.equippedArmorShield.name}}
                    {{#if actor.equippedArmorShield.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}
                  </h4>
                </div>
                <div class='item-attribute'>
                  <span>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.abbv'}}:
                    <input class='input-skill' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{actor.equippedArmorShield.id}}' value='{{actor.equippedArmorShield.system.rating.value}}'/>
                    / {{actor.equippedArmorShield.system.rating.max}}
                  </span>
                </div>
                <div class='item-attribute'><span>{{localize 'WRATH_OF_DAVOKAR.Armor.ParryBonus.abbv'}}: {{actor.equippedArmorShield.system.parryBonus}}</span></div>
                <div class='item-controls'>
                  <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorShield")}}'>
                    <img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/>
                  </a>
                </div>
              </div>
              <div class="flex-row quality-list-row">
                {{#each actor.equippedArmorShield.system.qualities as |quality|}}<label class='quality flexshrink'>{{#if quality}}{{localizeQuality @key}}{{/if}}</label>{{/each}}
              </div>
            </li>
          {{/if}}

        </ol>
        <div class="attributes-final-row">{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.Total'}}: {{system.armorRating.value}} / {{system.armorRating.max}}</div>
      </div>

      {{!-- At-hand Item Slots --}}
      <div class="panel">
        <div class="panel-header">{{localize "WRATH_OF_DAVOKAR.Item.ItemSlots.label"}}</div>
        {{generateItemSlotsHTML actorId}}
      </div>

      {{!-- Worn Items --}}
      <div class="panel">
        <div class="panel-header">{{localize "WRATH_OF_DAVOKAR.Item.WornItems"}}</div>
        {{generateWornItemsHTML actorId}}
      </div>

      {{!-- Conditions --}}
      <div class="panel">
        <div class="panel-header">{{localize "WRATH_OF_DAVOKAR.Condition"}}</div>
        <ol class='panel-content items-list'>
          {{#each conditions as |item|}}
            <li class='item flex-column' data-item-id='{{item._id}}'>
              <div class="flex-row max-width">
                <div class='item-name'>
                  <div class='item-image'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
                  </div>
                  <h4>{{item.name}}</h4>
                </div>
                <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Rank.Label'}}: {{item.system.rank.value}}</div>
                <div class='item-controls'>
                  <a class='item-control' data-action="itemEdit" title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice fa-xl'></i></a>
                  <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "WRATH_OF_DAVOKAR.Condition")}}'><i class='fas fa-trash'></i></a>
                </div>
              </div>
              <div class="flex-row">
                <prose-mirror name="system.bio.description" toggled="true">{{{item.enrichedDescription}}}</prose-mirror>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

      {{!-- Critical Injuries --}}
      <div class="panel">
        <div class="panel-header">{{localize "WRATH_OF_DAVOKAR.CriticalInjury.Label"}}</div>
        <ol class='panel-content items-list'>
          {{#each criticalInjuries as |item|}}
            <li class='item flex-column' data-item-id='{{item._id}}'>
              <div class="flex-row max-width">
                <div class='item-name'>
                  <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
                  <h4>{{item.name}}</h4>
                </div>
                <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.CriticalInjury.DeathMod'}}: {{item.system.deathMod}}</div>
                <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.CriticalInjury.HealingTime.Label'}}: {{item.system.healingTime.value}}</div>
                <div class='item-controls'>
                  <a class='item-control' data-action="itemEdit" title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice fa-xl'></i></a>
                  <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "WRATH_OF_DAVOKAR.CriticalInjury.Label")}}'><i class='fas fa-trash'></i></a>
                </div>
              </div>
              <div class="flex-row">
                <prose-mirror name="system.bio.description" toggled="true">{{{item.enrichedDescription}}}</prose-mirror>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

    </div>
  </div>

</section>
