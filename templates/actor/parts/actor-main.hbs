          <select class="flexgrow" name="system.skills.spellcasting.attribute">
            <option value="physique"  {{#if (eq 'physique'  system.skills.spellcasting.attribute)}}selected{{/if}}>{{localize "WRATH_OF_DAVOKAR.Attributes.Physique.long"}}</option>
            <option value="finesse"   {{#if (eq 'finesse'   system.skills.spellcasting.attribute)}}selected{{/if}}>{{localize "WRATH_OF_DAVOKAR.Attributes.Finesse.long"}}</option>
