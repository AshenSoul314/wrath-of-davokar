            {{#if (lt system.skills.volition.bonus 0)}}<span class="skill-bonus" title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.skills.volition.bonus}})</span>{{/if}}
