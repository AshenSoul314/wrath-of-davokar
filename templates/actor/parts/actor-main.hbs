            <option value="volition"     {{#if (eq 'volition'     system.skills.spellcasting.skill)}}selected{{/if}}>{{localize "WRATH_OF_DAVOKAR.Skills.Volition.long"}}</option>
            <option value="corruption"   {{#if (eq 'corruption'   system.skills.spellcasting.skill)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Corruption.Total'}}</option>
          </select>
          <div>+</div>
          <div>
            {{#if (gt system.skills.spellcasting.bonus 0)}}<span title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(+{{system.skills.spellcasting.bonus}})</span>{{/if}}
            {{#if (lt system.skills.spellcasting.bonus 0)}}<span title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">({{system.skills.spellcasting.bonus}})</span>{{/if}}
            {{#if (eq system.skills.spellcasting.bonus 0)}}<span title="{{localize 'WRATH_OF_DAVOKAR.Base.ToolTips.SkillBonus'}}">(±0)</span>{{/if}}
          </div>
          <div> = </div>
          <div class="spellcasting-total">{{system.skills.spellcasting.total}}</div>
