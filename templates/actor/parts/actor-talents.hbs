<section class="tab {{tab.cssClass}} talents-tab " data-group="primary" data-tab="talents">

  <div class="sticky">
    {{> "templates/generic/tab-navigation.hbs" tabs=talentTabs}}

    {{!-- Search Bar --}}
    <div class='search-bar flex-row'>
      <i class='fa-solid fa-magnifying-glass search-icon'></i>
      <input class="search-input" type='text'>
    </div>
  </div>

  <div class="talents-body">

    <section class="tab {{subTabs.talents.cssClass}}" data-group="talents" data-tab="talents">
      {{> "systems/wrath-of-davokar/templates/actor/parts/talents/talents-talents.hbs"}}
    </section>

    <section class="tab {{subTabs.traits.cssClass}}" data-group="talents" data-tab="traits">
      {{> "systems/wrath-of-davokar/templates/actor/parts/talents/talents-traits.hbs"}}
    </section>

    <section class="tab {{subTabs.boons.cssClass}}" data-group="talents" data-tab="boons">
      {{> "systems/wrath-of-davokar/templates/actor/parts/talents/talents-boons.hbs"}}
    </section>

    <section class="tab {{subTabs.burdens.cssClass}}" data-group="talents" data-tab="burdens">
      {{> "systems/wrath-of-davokar/templates/actor/parts/talents/talents-burdens.hbs"}}
    </section>

  </div>
</section>
