<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="items">

  {{!-- Encumbrance --}}
  <div class="flex-row flex-align-center flex-gap">
    <span class="resource-title">{{localize 'WRATH_OF_DAVOKAR.Item.Encumbrance'}}:</span>
    <span class="resource-text">{{system.encumbrance.value}} / {{system.encumbrance.max}}</span>
  </div>

  {{!-- Money --}}
  <div class="resource-grid-4">
    <span class="resource-title grid-span-8">{{localize 'WRATH_OF_DAVOKAR.Money.Label'}}</span>
    <i class="fa-solid fa-coins" style="padding-left: 2em;"></i>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Ambrian'}}</span>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Thaler'}}</span>
    <input type='number' step="1" min="0" name="system.money.thaler"   value="{{system.money.thaler}}"   data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Shilling'}}</span>
    <input type='number' step="1" min="0" name="system.money.shilling" value="{{system.money.shilling}}" data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Orteg'}}</span>
    <input type='number' step="1" min="0" name="system.money.orteg"    value="{{system.money.orteg}}"    data-dtype="Number"/>
    <i class="fa-solid fa-gem" style="padding-left: 2em;"></i>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Davokari'}}</span>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Saphire'}}</span>
    <input type='number' step="1" min="0" name="system.money.saphire"  value="{{system.money.saphire}}"  data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Ruby'}}</span>
    <input type='number' step="1" min="0" name="system.money.ruby"     value="{{system.money.ruby}}"     data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Obsidian'}}</span>
    <input type='number' step="1" min="0" name="system.money.obsidian" value="{{system.money.obsidian}}"  data-dtype="Number"/>
  </div>
  <hr>

  {{!-- Body Armor --}}
  {{#if armorBody}}
  <div class='items-title'>{{localize "TYPES.Item.armorBody"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.Impeding.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each armorBody as |item|}}
      <li class='item flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row max-width">
          <div class='item-name item-control' data-action="itemEdit">
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute'>
            <input class="input-skill" data-action="armorRatingChange" data-item-id="{{item._id}}" type='number' step="1" min="0" value="{{item.system.rating.value}}"/>
            / {{item.system.rating.max}}
          </div>
          <div class='item-attribute'>{{item.system.impeding}}</div>
          <div class='item-attribute'>{{item.system.weight}}</div>
          <div class='item-controls'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorBody")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorBody")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
            {{/if}}
            <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorBody")}}'><i class='fas fa-trash'></i></a>
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{#each item.system.qualities as |quality|}}{{#if quality}}<label class='quality'>{{localizeQuality @key}}</label>{{/if}}{{/each}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Helmets --}}
  {{#if armorHead}}
  <div class='items-title'>{{localize "TYPES.Item.armorHead"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.VisionPenalty.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each armorHead as |item|}}
      <li class='item flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row max-width">
          <div class='item-name item-control' data-action="itemEdit">
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute'>
            <input class="input-skill" data-action="armorRatingChange" data-item-id="{{item._id}}" type='number' step="1" min="0" value="{{item.system.rating.value}}"/>
            / {{item.system.rating.max}}
          </div>
          <div class='item-attribute'>{{item.system.visionPenalty}}</div>
          <div class='item-attribute'>{{item.system.weight}}</div>
          <div class='item-controls'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorHead")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorHead")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
            {{/if}}
            <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorHead")}}'><i class='fas fa-trash'></i></a>
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{#each item.system.qualities as |quality|}}{{#if quality}}<label class='quality'>{{localizeQuality @key}}</label>{{/if}}{{/each}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Shields --}}
  {{#if armorShield}}
  <div class='items-title'>{{localize "TYPES.Item.armorShield"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Armor.ParryBonus.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each armorShield as |item|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name item-control' data-action="itemEdit">
          <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
          <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
        </div>
        <div class='item-attribute'>
          <input class="input-skill" data-action="armorRatingChange" data-item-id="{{item._id}}" type='number' step="1" min="0" value="{{item.system.rating.value}}"/>
          / {{item.system.rating.max}}
        </div>
        <div class='item-attribute'>+{{item.system.parryBonus}}</div>
        <div class='item-attribute'>{{item.system.weight}}</div>
        <div class='item-controls'>
          {{#if item.system.equip.isEquipped}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorShield")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
          {{else}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorShield")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
          {{/if}}
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorShield")}}'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Weapons --}}
  {{#if weapons}}
  <div class='items-title'>{{localize "TYPES.Item.weapon"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Weapon.BaseDamage.long'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.Label'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Range.Label'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each weapons as |item|}}
      <li class='item flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row max-width">
          <div class='item-name item-control' data-action="itemEdit">
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute'>{{item.system.damage}}</div>
          <div class='item-attribute'>
            {{#if (eq 'oneHand' item.system.grip)}}{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.OneHand.abbv'}}{{/if}}
            {{#if (eq 'twoHand' item.system.grip)}}{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.TwoHand.abbv'}}{{/if}}
          </div>
          <div class='item-attribute'>
            {{#if (eq '0' item.system.range)}}{{localize 'WRATH_OF_DAVOKAR.Range.Engaged'}}{{/if}}
            {{#if (eq '1' item.system.range)}}1 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '2' item.system.range)}}2 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '3' item.system.range)}}3 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '4' item.system.range)}}4 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
          </div>
          <div class='item-attribute'>{{item.system.weight}}</div>
          <div class='item-controls'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.weapon")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.weapon")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice fa-xl'></i></a>
            <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.weapon")}}'><i class='fas fa-trash'></i></a>
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{#each item.system.qualities as |quality|}}{{#if quality}}<label class='quality'>{{localizeQuality @key}}</label>{{/if}}{{/each}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Gear --}}
  {{#if gear}}
  <div class='items-title'>{{localize "TYPES.Item.gear"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Durability'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each gear as |item|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name item-control' data-action="itemEdit">
          <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
          <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
        </div>
        <div class='item-attribute'>{{item.system.durability.value}} / {{item.system.durability.max}}</div>
        <div class='item-attribute'>{{item.system.weight}}</div>
        <div class='item-controls'>
          {{#if item.system.equip.isEquipped}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.gear")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
          {{else}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.gear")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
          {{/if}}
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.gear")}}'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Supplies --}}
  {{#if supplies}}
  <div class='items-title'>{{localize "TYPES.Item.supply"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Supply'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each supplies as |item|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name item-control' data-action="itemEdit">
          <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
          <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
        </div>
        <div class='item-attribute'>{{item.system.supply}}</div>
        <div class='item-attribute'>{{item.system.weight}}</div>
        <div class='item-controls'>
          {{#if item.system.equip.isEquipped}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.supply")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
          {{else}}
            <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.supply")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
          {{/if}}
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.supply")}}'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Everything Else --}}
  {{#if equipment}}
  <div class='items-title'>{{localize "TYPES.Item.equipment"}}</div>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'WRATH_OF_DAVOKAR.Base.Name'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Type'}}</div>
      <div class='item-attribute'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each equipment as |item|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name item-control' data-action="itemEdit">
          <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
          <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
        </div>
        <div class='item-attribute'>
          {{#if (eq item.type 'equipment')}}{{localize "TYPES.Item.equipment"}}{{/if}}
          {{#if (eq item.type 'trap')}}{{localize "TYPES.Item.trap"}}{{/if}}
          {{#if (eq item.type 'alchemicalItem')}}{{localize "TYPES.Item.alchemicalItem"}}{{/if}}
          {{#if (eq item.type 'container')}}{{localize "TYPES.Item.container"}}{{/if}}
        </div>
        <div class='item-attribute'>{{item.system.weight}}</div>
        <div class='item-controls'>
          {{#if item.system.equip}}
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.equipment")}}'><img src='systems/wrath-of-davokar/assets/icons/battle-gear.svg' width='24' height='24'/></a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.equipment")}}'><img src='systems/wrath-of-davokar/assets/icons/backpack.svg' width='24' height='24'/></a>
            {{/if}}
          {{/if}}
          <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.equipment")}}'><i class='fas fa-trash'></i></a>
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

</section>
