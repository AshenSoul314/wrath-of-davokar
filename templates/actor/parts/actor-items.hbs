            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute armor-rating'>
            <div class="flex-row flex-align-center max-width">
              <input class='input-skill flex-grow' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{item.id}}' value='{{item.system.rating.value}}'/>
              <span class="flex-grow">/</span>
              <span class="flex-grow">{{item.system.rating.max}}</span>
            </div>
          </div>
          <div class='item-attribute parry-bonus'>+{{item.system.parryBonus}}</div>
          <div class='item-attribute weight'>{{item.system.weight}}</div>
          <div class='item-controls flex-align-center {{#if ../editMode}}edit-mode{{/if}}'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorShield")}}'>
                <i class="fa-solid fa-hand"></i>
              </a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorShield")}}'>
                <i class="fa-solid fa-suitcase"></i>
              </a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

            {{#if ../editMode}}
              <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.armorShield")}}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorShield")}}'><i class='fas fa-trash'></i></a>
            {{/if}}
          </div>
        </div>
        <div class="flex-row quality-list-row">
