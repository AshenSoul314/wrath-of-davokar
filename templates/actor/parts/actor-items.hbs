    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.gear"}}</div>
      <div class='item-attribute durability'>{{localize 'WRATH_OF_DAVOKAR.Item.Durability'}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls {{#if editMode}}edit-mode{{/if}}'></div>
    </li>
    {{#each gear as |item|}}

      <li class='item draggable flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row flex-align-center max-width">
          <div class='item-name'>
