<section class="tab {{tab.cssClass}} items-tab" data-group="primary" data-tab="items">


  {{!-- Money --}}
  <div class="resource-grid-4">
    <span class="resource-title grid-span-8">{{localize 'WRATH_OF_DAVOKAR.Money.Label'}}</span>
    <i class="fa-solid fa-coins" style="padding-left: 2em;"></i>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Ambrian'}}</span>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Thaler'}}</span>
    <input type='number' step="1" min="0" name="system.money.thaler"   value="{{system.money.thaler}}"   data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Shilling'}}</span>
    <input type='number' step="1" min="0" name="system.money.shilling" value="{{system.money.shilling}}" data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Orteg'}}</span>
    <input type='number' step="1" min="0" name="system.money.orteg"    value="{{system.money.orteg}}"    data-dtype="Number"/>
    <i class="fa-solid fa-gem" style="padding-left: 2em;"></i>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Davokari'}}</span>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Saphire'}}</span>
    <input type='number' step="1" min="0" name="system.money.saphire"  value="{{system.money.saphire}}"  data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Ruby'}}</span>
    <input type='number' step="1" min="0" name="system.money.ruby"     value="{{system.money.ruby}}"     data-dtype="Number"/>
    <span class="resource-text">{{localize 'WRATH_OF_DAVOKAR.Money.Obsidian'}}</span>
    <input type='number' step="1" min="0" name="system.money.obsidian" value="{{system.money.obsidian}}" data-dtype="Number"/>
  </div>

  <div class="mid-sticky">
    {{!-- Encumbrance --}}
    <div class="flex-row flex-align-center flex-gap">
      <span class="resource-title">{{localize 'WRATH_OF_DAVOKAR.Item.Encumbrance'}}:</span>
      <span class="resource-text">
        <span {{#if (gt system.encumbrance.value system.encumbrance.max)}}class="red-pulse"{{/if}}>{{system.encumbrance.value}}</span> / {{system.encumbrance.max}}</span>
    </div>

    {{!-- Search Bar --}}
    <div class='search-bar flex-row'>
      <i class='fa-solid fa-magnifying-glass search-icon'></i>
      <input class="search-input" type='text'>
    </div>
  </div>

  {{!-- Body Armor --}}
  {{#if armorBody}}
  <ol class='items-list'>
    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.armorBody"}}</div>
      <div class='item-attribute armor-rating'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute impeding'>{{localize 'WRATH_OF_DAVOKAR.Armor.Impeding.long'}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls {{#if editMode}}edit-mode{{/if}}'></div>
    </li>
    {{#each armorBody as |item|}}
      <li class='item draggable flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row flex-align-center max-width">

          <div class='item-name'>
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute armor-rating'>
            <div class="flex-row flex-align-center max-width">
              <input class='input-skill flex-grow' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{item.id}}' value='{{item.system.rating.value}}'/>
              <span class="flex-grow">/</span>
              <span class="flex-grow">{{item.system.rating.max}}</span>
            </div>
          </div>
          <div class='item-attribute impeding'>{{item.system.impeding}}</div>
          <div class='item-attribute weight'>{{item.system.weight}}</div>
          <div class='item-controls flex-align-center {{#if ../editMode}}edit-mode{{/if}}'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorBody")}}'>
                <i class="fa-solid fa-hand"></i>
              </a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorBody")}}'>
                <i class="fa-solid fa-suitcase"></i>
              </a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

            {{#if ../editMode}}
              <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.armorBody")}}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorBody")}}'><i class='fas fa-trash'></i></a>
            {{/if}}
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{generateQualities item.system.qualities}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Helmets --}}
  {{#if armorHead}}
  <ol class='items-list'>
    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.armorHead"}}</div>
      <div class='item-attribute armor-rating'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute vision-penalty'>{{localize 'WRATH_OF_DAVOKAR.Armor.VisionPenalty.long'}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls {{#if editMode}}edit-mode{{/if}}'></div>
    </li>
    {{#each armorHead as |item|}}
      <li class='item draggable flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row flex-align-center max-width">
          <div class='item-name'>
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute armor-rating'>
            <div class="flex-row flex-align-center max-width">
              <input class='input-skill flex-grow' type='number' step="1" min="0" data-action="armorRatingChange" data-item-id='{{item.id}}' value='{{item.system.rating.value}}'/>
              <span class="flex-grow">/</span>
              <span class="flex-grow">{{item.system.rating.max}}</span>
            </div>
          </div>
          <div class='item-attribute vision-penalty'>{{item.system.visionPenalty}}</div>
          <div class='item-attribute weight'>{{item.system.weight}}</div>
          <div class='item-controls flex-align-center {{#if ../editMode}}edit-mode{{/if}}'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.armorHead")}}'>
                <i class="fa-solid fa-hand"></i>
              </a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.armorHead")}}'>
                <i class="fa-solid fa-suitcase"></i>
              </a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

            {{#if ../editMode}}
              <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.armorHead")}}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.armorHead")}}'><i class='fas fa-trash'></i></a>
            {{/if}}
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{generateQualities item.system.qualities}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Shields --}}
