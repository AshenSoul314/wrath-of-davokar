  {{!-- Alchemical Items --}}
  {{#if alchemicalItems}}
  <ol class='items-list'>
    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.alchemicalItem"}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
