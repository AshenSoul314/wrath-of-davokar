        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Weapons --}}
  {{#if weapons}}
  <ol class='items-list'>
    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.weapon"}}</div>
      <div class='item-attribute base-damage'>{{localize 'WRATH_OF_DAVOKAR.Weapon.BaseDamage.long'}}</div>
      <div class='item-attribute grip'>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.Label'}}</div>
      <div class='item-attribute range'>{{localize 'WRATH_OF_DAVOKAR.Range.Label'}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls {{#if editMode}}edit-mode{{/if}}'></div>
    </li>
    {{#each weapons as |item|}}
      <li class='item draggable flex-column' data-item-id='{{item._id}}'>
        <div class="flex-row flex-align-center max-width">
          <div class='item-name'>
            <div class='item-image'><img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/></div>
            <h4>{{item.name}}{{#if item.system.isArtifact}}<img class="icon" src='systems/wrath-of-davokar/assets/icons/artifact.svg' title='{{localize "WRATH_OF_DAVOKAR.Item.IsArtifact"}}' width='18' height='18'/>{{/if}}</h4>
          </div>
          <div class='item-attribute base-damage'>{{item.system.damage}}</div>
          <div class='item-attribute grip'>
            {{#if (eq 'oneHand' item.system.grip)}}{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.OneHand.abbv'}}{{/if}}
            {{#if (eq 'twoHand' item.system.grip)}}{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.TwoHand.abbv'}}{{/if}}
          </div>
          <div class='item-attribute range'>
            {{#if (eq '0' item.system.range)}}{{localize 'WRATH_OF_DAVOKAR.Range.Engaged'}}{{/if}}
            {{#if (eq '1' item.system.range)}}1 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '2' item.system.range)}}2 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '3' item.system.range)}}3 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
            {{#if (eq '4' item.system.range)}}4 {{localize 'WRATH_OF_DAVOKAR.Action.Move.abbv'}}{{/if}}
          </div>
          <div class='item-attribute weight'>{{item.system.weight}}</div>
          <div class='item-controls flex-align-center {{#if ../editMode}}edit-mode{{/if}}'>
            {{#if item.system.equip.isEquipped}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.UnequipItem" type=(localize "TYPES.Item.weapon")}}'>
                <i class="fa-solid fa-hand"></i>
              </a>
            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.weapon")}}'>
                <i class="fa-solid fa-suitcase"></i>
              </a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

            {{#if ../editMode}}
              <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.weapon")}}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.weapon")}}'><i class='fas fa-trash'></i></a>
            {{/if}}
          </div>
        </div>
        <div class="flex-row quality-list-row">
          {{generateQualities item.system.qualities}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{/if}}

  {{!-- Gear --}}
  {{#if gear}}
