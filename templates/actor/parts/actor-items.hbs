            {{else}}
              <a class='item-control' data-action="itemEquip" title='{{localize "WRATH_OF_DAVOKAR.Item.EquipItem" type=(localize "TYPES.Item.supply")}}'>
                <i class="fa-solid fa-suitcase"></i>
              </a>
            {{/if}}
            <a class='item-control' data-action="itemRoll"   title='{{localize "WRATH_OF_DAVOKAR.Item.Use"}}'><i class='fa-solid fa-dice'></i></a>

            {{#if ../editMode}}
              <a class='item-control' data-action="itemEdit"   title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.supply")}}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action="itemDelete" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.supply")}}'><i class='fas fa-trash'></i></a>
