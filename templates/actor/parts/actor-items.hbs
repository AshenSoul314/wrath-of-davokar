    <li class='item flex-row items-header'>
      <div class='item-name'>{{localize "TYPES.Item.armorShield"}}</div>
      <div class='item-attribute armor-rating'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}</div>
      <div class='item-attribute parry-bonus'>{{localize 'WRATH_OF_DAVOKAR.Armor.ParryBonus.long'}}</div>
      <div class='item-attribute weight'>{{localize 'WRATH_OF_DAVOKAR.Item.Weight'}}</div>
      <div class='item-controls {{#if editMode}}edit-mode{{/if}}'></div>
    </li>
    {{#each armorShield as |item|}}
