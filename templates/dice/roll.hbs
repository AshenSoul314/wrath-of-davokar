<div class="chat-card-frame">
  <div class="wrath-of-davokar chat-card">
    <div class="card-content">
      <div class="dice-roll">
        {{#if flavor}}
        <div class="dice-flavor">{{flavor}}</div>
        {{/if}}
        <div class="dice-result">
          <div class="dice-formula">{{formula}}</div>
          {{{tooltip}}}
          {{#if (and t2k (not isPrivate))}}
          <h4 class="dice-total">{{baseSuccessQty}}{{#if ammoSpent}}&nbsp;({{hitCount}}){{/if}}</h4>
          {{else}}
          <h4 class="dice-total">{{total}}</h4>
          {{/if}}
          {{#if (gt success 0)}}
          <h4 class="dice-total success">{{localize "YZUR.CHAT.Successes"}} : {{success}}</h4>
          {{/if}}
          {{#if (eq success 0)}}
          <h4 class="dice-total failure"> {{localize "YZUR.CHAT.Successes"}} : {{success}}</h4>
          {{/if}}
        </div>
      </div>

      {{!-- Extra info added for Year Zero rolls --}}
      {{#if showInfos}}
      {{{infos}}}
      {{/if}}

      {{!-- Buttons --}}
      {{#unless roll.options.keep}}
        {{#if pushable}}
          <div class="dice-buttons">
            {{!-- Push Button --}}
            <button class="dice-button dice-push" data-action="push" data-owner-id="{{roll.owner}}">{{localize "YZUR.CHAT.ROLL.Push"}} ({{roll.pushCount}}/{{roll.maxPush}})</button>

            {{!-- Accept Button --}}
            <button class="dice-button dice-keep">{{localize "WRATH_OF_DAVOKAR.Chat.Roll.Keep"}}</button>
          </div>
        {{/if}}
      {{/unless}}

      {{!-- Apply Button --}}
      {{#if roll.options.applyData}}
        <div class="apply-section"></div>
      {{/if}}
    </div>
  </div>
</div>