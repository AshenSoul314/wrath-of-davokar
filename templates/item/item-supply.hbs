{{! Supply Tab }}
<section class='tab sheet-body item-supply {{tab.cssClass}}' data-group='primary' data-tab='main'>
  <div class="resource-grid ">
    {{!-- Supply Points --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Item.SupplyPoints'}}:</label>
    <input type='text' name='system.supply' value='{{system.supply}}'/>

    {{!-- Qualities --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Qualities.Label'}}:</label>
    <div class='flex-row flex-align-center flex-wrap flex-gap'>
      {{#each system.qualities}}
        {{#if this}} <span class='quality'>{{localizeQuality @key}}</span>{{/if}}
      {{/each}}
    </div>

    {{!-- Cost --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Cost'}}:</label>
    {{#if editMode}}
      <div class='indent resource-grid'>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Thaler'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.thaler' data-dtype='Number' value='{{system.cost.thaler}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Shilling'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.shilling' data-dtype='Number' value='{{system.cost.shilling}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Orteg'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.orteg' data-dtype='Number' value='{{system.cost.orteg}}'/>
      </div>
    {{else}}
      <span>{{localizeCost system.cost}}</span>
    {{/if}}
  </div>
  <hr>
  {{#if editMode}}
    <prose-mirror
      name="system.description"
      value="{{system.description}}"
      button="true"
      toggled="true"
    >
      {{{enrichedDescription}}}
    </prose-mirror>
  {{else}}
    {{{enrichedDescription}}}
  {{/if}}
</section>