
{{! ArmorBody Tab }}
<section class='tab sheet-body item-armorBody {{tab.cssClass}}' data-group='primary' data-tab='main'>
  <div class="resource-grid ">

    {{!-- Armor Rating --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Armor.Rating.long'}}:</label>
    <div class='flex-row flex-align-center flex-gap'>
      <input type='number' step='1' min='0' name='system.rating.value' data-dtype='Number' value='{{system.rating.value}}'/>
      <span class='flexshrink'> / </span>
      <input type='number' step='1' min='0' name='system.rating.max' data-dtype='Number' value='{{system.rating.max}}'/>
    </div>

    {{!-- Impeding --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Armor.Impeding.long'}}:</label>
    <input class='flexshrink' type='number' step='1' min='0' name='system.impeding' data-dtype='Number' value='{{system.impeding}}'/>

    {{!-- Type --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Armor.ArmorCategory.Label'}}:</label>
    <select class="flexshrink" name="system.armorCategory">
      <option value="light" {{#if (eq 'light' system.armorCategory)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Armor.ArmorCategory.Light'}}</option>
      <option value="medium" {{#if (eq 'medium' system.armorCategory)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Armor.ArmorCategory.Medium'}}</option>
      <option value="heavy" {{#if (eq 'heavy' system.armorCategory)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Armor.ArmorCategory.Heavy'}}</option>
    </select>

    {{!-- Qualities --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Qualities.Label'}}:</label>
    <div class='flex-row flex-align-center flex-wrap flex-gap'>
      {{#if system.qualities.noQuality}}
        <span>{{localize 'WRATH_OF_DAVOKAR.Qualities.NoQuality'}}</span>
      {{else}}
        {{#each system.qualities}}
          {{#if this}} <span class='quality'>{{localizeQuality @key}}</span>{{/if}}
        {{/each}}
      {{/if}}
    </div>

    {{!-- Cost --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Cost'}}:</label>
    <div class='indent grid grid-2col'>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Thaler'}}:</label>
        <input class='flexshrink' type='number' step='1' min='0' name='system.cost.thaler' data-dtype='Number' value='{{system.cost.thaler}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Shilling'}}:</label>
        <input class='flexshrink' type='number' step='1' min='0' name='system.cost.shilling' data-dtype='Number' value='{{system.cost.shilling}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Orteg'}}:</label>
        <input class='flexshrink' type='number' step='1' min='0' name='system.cost.orteg' data-dtype='Number' value='{{system.cost.orteg}}'/>
    </div>
  </div>
  <hr>
  <div class="form-group editor">
    {{#if editable}}
      <prose-mirror
        name="system.description"
        value="{{system.description}}"
        button="true"
        toggled="true"
      >
        {{{enrichedDescription}}}
      </prose-mirror>
    {{else}}
      {{{enrichedDescription}}}
    {{/if}}
  </div>
</section>
