{{! Mystical Power Tab }}
<section class='tab sheet-body item-mysticalPower {{tab.cssClass}}' data-group='primary' data-tab='main'>
  {{!-- Qualities --}}
  <div class='flex-row flex-align-center flex-wrap flex-gap'>
    {{#each system.qualities}}
      {{#if this}} <span class='quality'>{{localizeQuality @key}}</span>{{/if}}
    {{/each}}
  </div>

  <div class="resource-grid ">
    {{!-- Tradition --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Power.Tradition.Label'}}:</label>
    {{#if editMode}}
      <div class="flex-row flex-group-left flex-align-center flex-wrap">
        {{#each system.tradition}}
          <div class="flex-row flex-group-left flex-align-center">
            <label for="system.tradition.{{@key}}.value">{{this.label}}</label>
            <input  id="system.tradition.{{@key}}.value"
                    name="system.tradition.{{@key}}.value"
                    type="checkbox"
                    data-dtype="Boolean"
                    {{checked this.value}}/>
          </div>
        {{/each}}
      </div>
    {{else}}
      <span>{{localizeTraditions system.tradition}}</span>
    {{/if}}

    {{!-- Corruption --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Corruption.Label'}}:</label>
    {{#if editMode}}
      <input type='text' name='system.corruption' value='{{system.corruption}}'/>
    {{else}}
      <span>{{system.corruption}}</span>
    {{/if}}

    {{!-- Component --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Power.Component'}}:</label>
    {{#if editMode}}
      <input type='text' name='system.component' value='{{system.component}}'/>
    {{else}}
      <span>{{system.component}}</span>
    {{/if}}

    {{!-- Action(s) --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Action.Label'}}:</label>
    <span>{{localizeActions system.action}}</span>

    {{!-- Range --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Range.Label'}}:</label>
    {{#if editMode}}
      <div class='align-left flex-column flex-shrink'>
        <select name="system.range" data-dtype="Number">
          <option value=-1 {{#if (eq -1 system.range)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Range.Self'}}</option>
          <option value=0 {{#if (eq 0 system.range)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Range.Engaged'}}</option>
          <option value=1 {{#if (eq 1 system.range)}}selected{{/if}}>1 {{localize 'WRATH_OF_DAVOKAR.Action.Move.long'}}</option>
          <option value=2 {{#if (eq 2 system.range)}}selected{{/if}}>2 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=3 {{#if (eq 3 system.range)}}selected{{/if}}>3 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=4 {{#if (eq 4 system.range)}}selected{{/if}}>4 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=5 {{#if (eq 5 system.range)}}selected{{/if}}>5 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
        </select>
      </div>
    {{else}}
      <span>{{localizeRange system.range}}</span>
    {{/if}}
  </div>
  <hr>
  {{#if editMode}}
    <prose-mirror
      name="system.description"
      value="{{system.description}}"
      button="true"
      toggled="true"
    >
      {{{enrichedDescription}}}
    </prose-mirror>
  {{else}}
    {{{enrichedDescription}}}
  {{/if}}
</section>
