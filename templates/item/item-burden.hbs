
{{! Description Tab }}
<section class='tab sheet-body item-burden {{tab.cssClass}}' data-group='primary' data-tab='main'>
  {{#if editMode}}
    <prose-mirror
      name="system.description"
      value="{{system.description}}"
      button="true"
      toggled="true"
    >
      {{{enrichedDescription}}}
    </prose-mirror>
  {{else}}
    {{{enrichedDescription}}}
  {{/if}}
</section>