<div class='flex-column flex-group-center flex-align-stretch flex-gap'>

  {{#each system.powers}}
    <div class="panel artifact-power flex-group-left" data-artifact-power-id="{{@key}}">
      <div class="panel-header flex-row flex-group-center flex-gap">
        <div class='item-image'>
          <a class='rollable interactive' data-roll-type='item'>
            <img src='{{this.img}}' title='{{this.name}}' width='32' height='32' />
          </a>
        </div>
        <input type='text' name='system.powers.{{@key}}.name' value='{{this.name}}'/>
        <a class='item-control artifact-power-delete' data-artifact-power-id="{{@key}}" title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.artifactPower")}}'>
          <i class='fas fa-trash'></i>
        </a>
      </div>

      <div class="panel-content">

        <div class="resource-grid  align-left">

          {{!-- Icon --}}
          <label class='resource-label'>{{localize 'DOCUMENT.FIELDS.img.label'}}:</label>
          <file-picker type="image" name='system.powers.{{@key}}.img' noupload="true" value="{{this.img}}"></file-picker>

          {{!-- Action --}}
          <span class="resource-label grid-span-2">{{localize 'WRATH_OF_DAVOKAR.Action.Label'}}</span>

          <label for="system.action.{{@key}}.reaction.value">{{localize "WRATH_OF_DAVOKAR.Action.Reaction"}}</label>
          <input id="system.action.{{@key}}.reaction.value" name="system.action.{{@key}}.reaction.value" type="checkbox" value="true" {{checked this.reaction.value}}/>

          <label for="system.action.{{@key}}.passive.value">{{localize "WRATH_OF_DAVOKAR.Action.Passive"}}</label>
          <input id="system.action.{{@key}}.passive.value" name="system.action.{{@key}}.passive.value" type="checkbox" value="true" {{checked this.passive.value}}/>

          <label for="system.action.{{@key}}.fast.value">{{localize "WRATH_OF_DAVOKAR.Action.Fast.abbr"}}</label>
          <input id="system.action.{{@key}}.fast.value" name="system.action.{{@key}}.fast.value" type="checkbox" value="true" {{checked this.fast.value}}/>

          <label for="system.action.{{@key}}.slow.value">{{localize "WRATH_OF_DAVOKAR.Action.Slow.abbr"}}</label>
          <input id="system.action.{{@key}}.slow.value" name="system.action.{{@key}}.slow.value" type="checkbox" value="true" {{checked this.slow.value}}/>

          <label for="system.action.{{@key}}.free.value">{{localize "WRATH_OF_DAVOKAR.Action.Free.abbr"}}</label>
          <input id="system.action.{{@key}}.free.value" name="system.action.{{@key}}.free.value" type="checkbox" value="true" {{checked this.free.value}}/>

          <label for="system.action.{{@key}}.special.value">{{localize "WRATH_OF_DAVOKAR.Action.Special"}}</label>
          <input id="system.action.{{@key}}.special.value" name="system.action.{{@key}}.special.value" type="checkbox" value="true" {{checked this.special.value}}/>

          {{!-- Corruption --}}
          <span class="resource-label">{{localize 'WRATH_OF_DAVOKAR.Corruption.Label'}}</span>
          <input type='text' name='system.powers.{{@key}}.corruption' value='{{this.corruption}}'/>
        </div>
        {{! Description }}
        <span class="resource-label">{{localize 'Description'}}</span>
        {{editor
          this.enrichedDescription
          target=(concat 'system.powers.' @key '.description')
          engine='prosemirror'
          button=true
          editable=true
        }}

        {{! Macro }}
        <span class="resource-label">{{localize 'DOCUMENT.Macro'}}</span>
        <file-picker type="any" name='system.powers.{{@key}}.macro' noupload="true" value="{{this.macro}}"></file-picker>
      </div>
    </div>
  {{/each}}

  <div class="item-controls">
      <a class="artifact-power-create" data-action="create" title="{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.artifactPower")}}">
      <i class="fas fa-plus"></i> {{localize "DOCUMENT.Create" type=(localize "TYPES.Item.artifactPower")}}
    </a>
  </div>
</div>