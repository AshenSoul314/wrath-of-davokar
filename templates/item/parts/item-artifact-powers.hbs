<section class='tab item-artifact-powers {{tab.cssClass}}' data-group='primary' data-tab='artifactPowers'>

  <p class="panel-like-item notification info">
    {{localize 'WRATH_OF_DAVOKAR.Artifact.PowersReadOnly'}}
  </p>

  <div class='flex-column flex-group-center flex-align-stretch flex-gap'>
    {{#each artifactPowerEntries}}
      <div class="panel artifact-power flex-group-left">

        <div class="panel-header flex-row flex-group-center flex-gap">
          {{#if this.missing}}
            <i class="fas fa-triangle-exclamation artifact-power-warning"
               data-tooltip="{{localize 'WRATH_OF_DAVOKAR.Artifact.PowerMissing'}}">
            </i>
            <span class="artifact-power-id">{{this.artifactPowerId}}</span>
          {{else}}
            <div class='item-image'>
              <img src='{{this.img}}' title='{{this.name}}' width='32' height='32' />
            </div>
            <span class="flex-grow">{{this.name}}</span>
          {{/if}}
        </div>

        {{#unless this.missing}}
          <div class="panel-content">
            <div class="resource-grid ">
              {{!-- Actions --}}
              <b>{{localize "WRATH_OF_DAVOKAR.Action.Label"}}:</b>
              <span>{{localizeActions this.action}}</span>

              {{!-- Corruption --}}
              <b>{{localize 'WRATH_OF_DAVOKAR.Corruption.Label'}}:</b>
              <span class='die-roll rollable' data-roll="{{this.corruption}}" data-label="{{localize 'WRATH_OF_DAVOKAR.Corruption.Temporary.long'}}">
                <i class="fa-solid fa-dice fa-xl-d20"></i> {{this.corruption}}
              </span>
            </div>

            {{{this.enrichedDescription}}}
          </div>
        {{/unless}}

      </div>
    {{else}}
      <p class="artifact-powers-empty dimmed">
        {{localize 'WRATH_OF_DAVOKAR.Artifact.NoPowers'}}
      </p>
    {{/each}}
  </div>

</section>