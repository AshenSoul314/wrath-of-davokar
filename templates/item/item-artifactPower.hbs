{{! Artifact Power Tab }}
<section class='tab sheet-body item-artifactPower {{tab.cssClass}}' data-group='primary' data-tab='main'>
  <div class="resource-grid ">

    {{!-- Corruption --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Corruption.Label'}}:</label>
    {{#if editMode}}
      <input type='text' name='system.corruption' value='{{system.corruption}}'/>
    {{else}}
      <span>{{system.corruption}}</span>
    {{/if}}

    {{!-- Action(s) --}}
    <label class='resource-label'>{{localize 'WRATH_OF_DAVOKAR.Action.Label'}}:</label>
    <span>{{localizeActions system.action}}</span>
  </div>
  <hr>
  {{#if editMode}}
    <prose-mirror
      name="system.description"
      value="{{system.description}}"
      button="true"
      toggled="true"
    >
      {{{enrichedDescription}}}
    </prose-mirror>
  {{else}}
    {{{enrichedDescription}}}
  {{/if}}
</section>
