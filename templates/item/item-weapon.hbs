
{{! Description Tab }}
<section class='tab sheet-body item-weapon {{tab.cssClass}}' data-group='primary' data-tab='main'>
  <div class="resource-grid ">

    {{!-- Grip --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.Label'}}:</label>
    {{#if editMode}}
      <select class="flex-shrink" name="system.grip">
        <option value="oneHand" {{#if (eq 'oneHand' system.grip)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.OneHand.long'}}</option>
        <option value="twoHand" {{#if (eq 'twoHand' system.grip)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.TwoHand.long'}}</option>
      </select>
    {{else}}
      {{#if (eq system.grip 'oneHand')}}
        <span>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.OneHand.long'}}</span>
      {{else if (eq system.grip 'twoHand')}}
        <span>{{localize 'WRATH_OF_DAVOKAR.Weapon.Grip.TwoHand.long'}}</span>
      {{/if}}
    {{/if}}

    {{!-- Base Damage --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Weapon.BaseDamage.long'}}:</label>
    {{#if editMode}}
      <input class='flex-shrink' type='number' step="1" min="0" name='system.damage' value='{{system.damage}}' data-dtype='Number'/>
    {{else}}
      <span>{{system.damage}}</span>
    {{/if}}

    {{!-- Range --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Range.Label'}}:</label>
    {{#if editMode}}
      <div class='align-left flex-column flex-shrink'>
        <select name="system.range" data-dtype="Number">
          <option value=-1 {{#if (eq -1 system.range)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Range.Self'}}</option>
          <option value=0 {{#if (eq 0 system.range)}}selected{{/if}}>{{localize 'WRATH_OF_DAVOKAR.Range.Engaged'}}</option>
          <option value=1 {{#if (eq 1 system.range)}}selected{{/if}}>1 {{localize 'WRATH_OF_DAVOKAR.Action.Move.long'}}</option>
          <option value=2 {{#if (eq 2 system.range)}}selected{{/if}}>2 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=3 {{#if (eq 3 system.range)}}selected{{/if}}>3 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=4 {{#if (eq 4 system.range)}}selected{{/if}}>4 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
          <option value=5 {{#if (eq 5 system.range)}}selected{{/if}}>5 {{localize 'WRATH_OF_DAVOKAR.Action.Move.plural'}}</option>
        </select>

        {{!-- Area --}}
        {{radioBoxes 'system.area.type' system.area.radio checked=system.area.type localize=true}}
      </div>
    {{else}}
      <span>{{localizeRange system.range area=system.area}}</span>
    {{/if}}

    {{!-- Weapon Types --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Weapon.Type.Label'}}:</label>
    <span>{{localizeWeaponTypes system.weaponType}}</span>

    {{!-- Qualities --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Qualities.Label'}}:</label>
    <div class='flex-row flex-align-center flex-wrap flex-gap'>
      {{#if system.qualities.noQuality}}
        <label class='class=flex-shrink'>{{localize 'WRATH_OF_DAVOKAR.Qualities.NoQuality'}}</label>
      {{else}}
        {{#each system.qualities}}
          {{#if this}} <label class='quality flex-shrink'>{{localizeQuality @key}}</label>{{/if}}
        {{/each}}
      {{/if}}
    </div>

    {{!-- Cost --}}
    <label class='resource-label align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Cost'}}:</label>
    {{#if editMode}}
      <div class='indent resource-grid'>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Thaler'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.thaler' data-dtype='Number' value='{{system.cost.thaler}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Shilling'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.shilling' data-dtype='Number' value='{{system.cost.shilling}}'/>
        <label class='align-left'>{{localize 'WRATH_OF_DAVOKAR.Money.Orteg'}}:</label>
        <input class='flex-shrink' type='number' step='1' min='0' name='system.cost.orteg' data-dtype='Number' value='{{system.cost.orteg}}'/>
      </div>
    {{else}}
      <span>{{localizeCost system.cost}}</span>
    {{/if}}
  </div>
  <hr>
  {{#if editMode}}
    <prose-mirror
      name="system.description"
      value="{{system.description}}"
      button="true"
      toggled="true"
    >
      {{{enrichedDescription}}}
    </prose-mirror>
  {{else}}
    {{{enrichedDescription}}}
  {{/if}}
</section>
