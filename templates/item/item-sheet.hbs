{{! This template is a fallback for when items don't have more specific templates. }}
<div class='{{cssClass}}'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <div class="flex-row flex-gap flex-group-left">
        <h1 class='charname flex-grow'><input
            name='name'
            type='text'
            value='{{item.name}}'
            placeholder='Name'
          /></h1>
          <a class='item-send-to-chat' title='{{localize "WRATH_OF_DAVOKAR.Base.ToolTips.SendToChat"}}' >
            <i class='fas fa-message'></i>
          </a>
      </div>
  </header>
</div>